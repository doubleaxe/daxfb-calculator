{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@doubleaxe/typescript-config/web.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    "importHelpers": true,
    "paths": {
      "#core/*": ["./src/*"]
    }
  },
  "include": ["src", "src/vite-env.d.ts"]
}
