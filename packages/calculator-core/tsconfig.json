{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@doubleaxe/typescript-config/web.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "importHelpers": true,
    "paths": {
      "#core/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
