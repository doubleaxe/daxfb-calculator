{
  "name": "@daxfb/core",
  "private": true,
  "version": "2.0.0-alpha.1",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "check": "vue-tsc --noEmit"
  },
  "imports": {
    "#core/*": "./src/*"
  },
  "exports": {
    "./game/model/index.js": "./src/game/model/index.ts",
    "./game/model/*.js": "./src/game/model/*.ts",
    "./game/parser/index.js": "./src/game/parser/index.ts",
    "./game/parser/*.js": "./src/game/parser/*.ts",
    "./stores/*.js": "./src/stores/*.ts",
    "./types/*.js": "./src/types/*.ts",
    "./ui/*.vue": "./src/ui/*.vue",
    "./ui/*.js": "./src/ui/*.ts",
    "./utils/*.js": "./src/utils/*.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@daxfb/shared": "workspace:*",
    "@daxfb/styles": "workspace:*",
    "@dnd-kit/dom": "catalog:",
    "@dnd-kit/vue": "catalog:",
    "@phosphor-icons/vue": "catalog:",
    "@primeuix/themes": "catalog:",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vueuse/core": "catalog:",
    "@xyflow/vue": "2.0.0-next.18",
    "nanoevents": "catalog:",
    "pako": "catalog:",
    "perfect-debounce": "catalog:",
    "primevue": "catalog:",
    "tslib": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
