{
  "name": "@doubleaxe/daxfb-calculator-core",
  "private": true,
  "version": "2.0.0-alpha.1",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "check": "tsc --noEmit"
  },
  "imports": {
    "#core/*": "./src/*"
  },
  "exports": {
    "./game/model": "./src/game/model/index.ts",
    "./game/model/*": "./src/game/model/*.ts",
    "./game/parser": "./src/game/parser/index.ts",
    "./game/parser/*": "./src/game/parser/*.ts",
    "./stores/*": "./src/stores/*.ts",
    "./types/*": "./src/types/*.ts",
    "./ui/init": "./src/ui/init.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./utils/*": "./src/utils/*.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@dnd-kit/dom": "catalog:",
    "@dnd-kit/react": "catalog:",
    "@doubleaxe/daxfb-calculator-styles": "workspace:*",
    "@doubleaxe/daxfb-shared": "workspace:*",
    "@mantine/core": "catalog:",
    "@mantine/hooks": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "@xyflow/react": "catalog:",
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
    "nanoevents": "catalog:",
    "pako": "catalog:",
    "perfect-debounce": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
