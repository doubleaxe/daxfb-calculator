{
  "name": "@doubleaxe/daxfb-calculator-core",
  "private": true,
  "version": "2.0.0-alpha.1",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "check": "tsc --noEmit"
  },
  "imports": {
    "#core/*": "./src/*"
  },
  "exports": {
    "./game/model": "./src/game/model/index.ts",
    "./game/model/*": "./src/game/model/*.ts",
    "./game/parser": "./src/game/parser/index.ts",
    "./game/parser/*": "./src/game/parser/*.ts",
    "./stores/*": "./src/stores/*.ts",
    "./types/*": "./src/types/*.ts",
    "./ui/init": "./src/ui/init.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./utils/*": "./src/utils/*.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@doubleaxe/daxfb-calculator-styles": "workspace:*",
    "@doubleaxe/daxfb-shared": "workspace:*",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.10.2",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "pako": "^2.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "catalog:"
  }
}
