{
  "name": "@daxfb/calculator",
  "private": true,
  "version": "2.0.0-alpha.1",
  "description": "Factory planner for management games - core UI lib",
  "keywords": [
    "game",
    "calculator",
    "factory planner"
  ],
  "author": "Alexey Usov (dax@xdax.ru)",
  "homepage": "https://github.com/doubleaxe/daxfb-calculator",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"CSS,VITE\" \"pnpm run watch-css\" \"pnpm run watch-vite\"",
    "watch-vite": "pnpm run wait-css && vite",
    "watch-css": "panda cssgen --watch",
    "wait-css": "wait-on --delay 500 file:./generated/styled-system/styles.css file:./node_modules/@daxfb/styles/generated/lib/panda/lib.json",
    "build": "run-s build-panda build-vite",
    "build-vite": "vite build",
    "build-panda": "panda cssgen --clean",
    "preview": "vite preview",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "check": "vue-tsc --noEmit"
  },
  "imports": {},
  "dependencies": {
    "@dnd-kit/dom": "catalog:",
    "@dnd-kit/react": "catalog:",
    "@daxfb/core": "workspace:*",
    "@daxfb/games.coi": "workspace:*",
    "@daxfb/styles": "workspace:*",
    "@daxfb/gamedata-generated": "workspace:*",
    "@daxfb/shared": "workspace:*",
    "@mantine/core": "catalog:",
    "@mantine/hooks": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "@primeuix/themes": "catalog:",
    "@vueuse/core": "catalog:",
    "@xyflow/react": "catalog:",
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
    "normalize.css": "^8.0.1",
    "pako": "catalog:",
    "primevue": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tslib": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.6.0",
    "concurrently": "catalog:",
    "cross-env": "^10.1.0",
    "npm-run-all": "catalog:",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "typescript": "catalog:",
    "vite": "^7.3.6",
    "vue-tsc": "catalog:",
    "wait-on": "catalog:"
  }
}
