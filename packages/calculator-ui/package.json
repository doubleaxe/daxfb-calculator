{
  "name": "@doubleaxe/daxfb-calculator",
  "private": true,
  "version": "2.0.0-alpha.1",
  "description": "Factory planner for management games - core UI lib",
  "keywords": [
    "game",
    "calculator",
    "factory planner"
  ],
  "author": "Alexey Usov (dax@xdax.ru)",
  "homepage": "https://github.com/doubleaxe/daxfb-calculator",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "prepare": "panda codegen --clean",
    "dev": "run-p watch-panda watch-vite",
    "watch-vite": "vite",
    "watch-panda": "panda --watch",
    "build": "tsc && vite build",
    "build-panda": "panda",
    "preview": "vite preview",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "check": "tsc --noEmit"
  },
  "imports": {},
  "dependencies": {
    "@dnd-kit/dom": "catalog:",
    "@dnd-kit/react": "catalog:",
    "@doubleaxe/daxfb-calculator-core": "workspace:*",
    "@doubleaxe/daxfb-calculator-games.coi": "workspace:*",
    "@doubleaxe/daxfb-calculator-styles": "workspace:*",
    "@doubleaxe/daxfb-gamedata-generated": "workspace:*",
    "@doubleaxe/daxfb-shared": "workspace:*",
    "@mantine/core": "catalog:",
    "@mantine/hooks": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "@xyflow/react": "catalog:",
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
    "pako": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.11.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "typescript": "catalog:",
    "vite": "^7.3.3"
  }
}
