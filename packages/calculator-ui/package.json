{
  "name": "@doubleaxe/daxfb-calculator",
  "private": true,
  "version": "2.0.0-alpha.1",
  "description": "Factory planner for management games - core UI lib",
  "keywords": [
    "game",
    "calculator",
    "factory planner"
  ],
  "author": "Alexey Usov (dax@xdax.ru)",
  "homepage": "https://github.com/doubleaxe/daxfb-calculator",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "prepare": "panda codegen --clean",
    "dev": "run-p watch-panda watch-vite",
    "watch-vite": "vite",
    "watch-panda": "panda --watch",
    "build": "tsc && vite build",
    "build-panda": "panda",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "imports": {
    "#core/*": "./node_modules/@doubleaxe/daxfb-calculator-core/src/*",
    "#daxfb-gamedata-generated/*": "./node_modules/@doubleaxe/daxfb-gamedata-generated/src/*",
    "#daxfb-shared/*": "./node_modules/@doubleaxe/daxfb-shared/src/*",
    "#game-ui-coi/*": "./node_modules/@doubleaxe/daxfb-calculator-games.coi/src/*"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@doubleaxe/daxfb-calculator-core": "workspace:*",
    "@doubleaxe/daxfb-calculator-games.coi": "workspace:*",
    "@doubleaxe/daxfb-calculator-styles": "workspace:*",
    "@doubleaxe/daxfb-gamedata-generated": "workspace:*",
    "@doubleaxe/daxfb-shared": "workspace:*",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.10.2",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "pako": "^2.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.27",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.9",
    "postcss-preset-mantine": "^1.18.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "typescript": "catalog:",
    "vite": "^7.3.2"
  }
}
