{
  "name": "@doubleaxe/daxfb-gamedata-generated",
  "private": true,
  "version": "2.0.0-alpha.1",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "check": "tsc --noEmit"
  },
  "exports": {
