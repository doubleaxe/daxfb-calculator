    "./coi/images.png": "./src/coi/images.png",
    "./coi/keys.json": "./src/coi/keys.json",
    "./coi/locales/*": "./src/coi/locales/*.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@doubleaxe/daxfb-shared": "workspace:*"
  }
