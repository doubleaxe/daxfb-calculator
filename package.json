{
  "name": "@doubleaxe/daxfb-calculator-workspace",
  "version": "2.0.0",
  "description": "Factory planner for management games - v2 react rewrite",
  "keywords": [
    "game",
    "calculator",
    "factory planner"
  ],
  "author": "Alexey Usov (dax@xdax.ru)",
  "homepage": "https://github.com/doubleaxe/daxfb-calculator",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "changeset-add": "@changesets/cli add",
    "changeset-release": "@changesets/cli version",
    "changeset-snapshot": "@changesets/cli version --snapshot"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@doubleaxe/eslint-config": "^2.0.7",
    "@doubleaxe/eslint-plugin-module-path-fixer": "^1.0.3",
    "@doubleaxe/prettier-config": "^1.0.5",
    "@doubleaxe/typescript-config": "^1.0.5",
    "@types/node": "^24.12.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.59.4"
  }
}
